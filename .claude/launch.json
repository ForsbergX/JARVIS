{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jarvis-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@jarvis/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "jarvis-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@jarvis/server"],
      "port": 4000,
      "autoPort": true
    }
  ]
}
